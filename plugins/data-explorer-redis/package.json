{
    "name": "@qodalis/cli-server-plugin-data-explorer-redis",
    "version": "1.0.0-beta.34",
    "description": "Redis data explorer provider plugin for Qodalis CLI server",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc"
    },
    "keywords": [
        "cli",
        "qodalis",
        "data-explorer",
        "redis",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/data-explorer-redis"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "^1.0.0-beta.2",
        "ioredis": "^5.4.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "data-explorer-redis",
        "entry": "./dist/plugin.js",
        "order": 70,
        "title": "Data explorer: Redis",
        "icon": "🟥",
        "config": {
            "entries": [
                {
                    "key": "name",
                    "label": "Source name",
                    "description": "Shown in the data explorer",
                    "type": "string",
                    "default": "redis",
                    "validation": {
                        "required": true,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "description",
                    "label": "Description",
                    "type": "string",
                    "default": "Redis database",
                    "requiresRestart": true
                },
                {
                    "key": "connectionString",
                    "label": "Connection string",
                    "description": "e.g. redis://:password@host:6379/0 (kept as a secret, never returned)",
                    "type": "secret",
                    "default": null,
                    "required": true,
                    "requiresRestart": true,
                    "sensitive": true
                },
                {
                    "key": "readOnly",
                    "label": "Read-only",
                    "description": "Queries may only read",
                    "type": "boolean",
                    "default": true,
                    "requiresRestart": true
                },
                {
                    "key": "timeoutMs",
                    "label": "Timeout (ms)",
                    "type": "number",
                    "default": 30000,
                    "validation": {
                        "min": 1000,
                        "max": 600000
                    },
                    "requiresRestart": true
                },
                {
                    "key": "maxRows",
                    "label": "Rows at most",
                    "type": "number",
                    "default": 1000,
                    "validation": {
                        "min": 1,
                        "max": 100000
                    },
                    "requiresRestart": true
                }
            ],
            "needsConfiguration": true
        }
    }
}
