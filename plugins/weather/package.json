{
    "name": "@qodalis/cli-server-plugin-weather",
    "version": "1.0.0-beta.34",
    "description": "Weather information plugin for Qodalis CLI server — provides current weather and forecast commands",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc"
    },
    "keywords": [
        "cli",
        "qodalis",
        "weather",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/weather"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "^1.0.0-beta.8"
    },
    "devDependencies": {
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "weather",
        "entry": "./dist/plugin.js",
        "title": "Weather",
        "icon": "🌤️",
        "platforms": {
            "python": "qodalis-cli-server-plugin-weather",
            "dotnet": "Qodalis.Cli.Plugin.Weather"
        },
        "config": {
            "entries": [
                {
                    "key": "defaultLocation",
                    "label": "Default location",
                    "description": "The place when a command names none",
                    "type": "string",
                    "default": "London",
                    "validation": {
                        "required": true,
                        "max": 100
                    },
                    "required": true
                }
            ]
        }
    }
}
