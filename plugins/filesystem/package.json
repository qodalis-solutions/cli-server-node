{
    "name": "@qodalis/cli-server-plugin-filesystem",
    "version": "1.0.0-beta.32",
    "description": "Pluggable file storage plugin for Qodalis CLI server — provides in-memory and OS filesystem providers",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "dashboard",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "copy-dashboard": "node scripts/copy-dashboard.js",
        "prebuild": "npm run copy-dashboard",
        "build": "tsc",
        "prepublishOnly": "npm run copy-dashboard"
    },
    "keywords": [
        "cli",
        "qodalis",
        "filesystem",
        "file-storage",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/filesystem"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "^1.0.0-beta.2"
    },
    "devDependencies": {
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "filesystem",
        "entry": "./dist/plugin.js",
        "title": "Filesystem",
        "icon": "📁",
        "config": {
            "entries": [
                {
                    "key": "roots",
                    "label": "Folders",
                    "description": "Absolute paths served (and everything below them); none: the filesystem API serves nothing",
                    "type": "string[]",
                    "default": [],
                    "validation": {
                        "pattern": "^(/|[A-Za-z]:[\\\\/]).*"
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "readOnly",
                    "label": "Read-only",
                    "description": "Only list, read and download: uploads, new folders and deletes are refused",
                    "type": "boolean",
                    "default": true,
                    "requiresRestart": true
                }
            ],
            "needsConfiguration": true
        }
    }
}
