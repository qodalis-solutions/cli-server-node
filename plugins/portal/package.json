{
    "name": "@qodalis/cli-server-plugin-portal",
    "version": "1.0.0-beta.31",
    "description": "Portal plugin for Qodalis CLI server — the prebuilt documentation portal (guides and API reference) at one mount, with portal.json",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "site",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "copy-portal": "node scripts/copy-portal.js",
        "prebuild": "npm run copy-portal",
        "build": "tsc",
        "prepublishOnly": "node scripts/copy-portal.js --publish"
    },
    "keywords": [
        "cli",
        "qodalis",
        "portal",
        "docs",
        "api-reference",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/portal"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "file:../../packages/abstractions"
    },
    "optionalDependencies": {
        "@qodalis/cli-server-portal": "^1.0.0-beta.28"
    },
    "peerDependencies": {
        "express": "^4.18.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "portal",
        "entry": "./dist/plugin.js",
        "order": 60,
        "title": "Portal",
        "icon": "🏠",
        "config": {
            "entries": [
                {
                    "key": "path",
                    "label": "Path",
                    "description": "Where the portal is served (/ for the root)",
                    "type": "string",
                    "default": "/qcli/portal",
                    "validation": {
                        "required": true,
                        "pattern": "^(/|(/[A-Za-z0-9._~-]+)+)$"
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "name",
                    "label": "Name",
                    "type": "string",
                    "default": "Documentation",
                    "validation": {
                        "required": true,
                        "max": 80
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "logoUrl",
                    "label": "Logo",
                    "description": "An http(s) URL or a root-relative path; empty: none",
                    "type": "string",
                    "default": "",
                    "validation": {
                        "max": 2000
                    },
                    "requiresRestart": true
                }
            ]
        }
    }
}
