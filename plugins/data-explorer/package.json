{
    "name": "@qodalis/cli-server-plugin-data-explorer",
    "version": "1.0.0-beta.35",
    "description": "Data explorer plugin for Qodalis CLI server — query and browse data sources",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "dashboard",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "copy-dashboard": "node scripts/copy-dashboard.js",
        "prebuild": "npm run copy-dashboard",
        "build": "tsc",
        "prepublishOnly": "npm run copy-dashboard"
    },
    "keywords": [
        "cli",
        "qodalis",
        "data-explorer",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/data-explorer"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "^1.0.0-beta.2"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "data-explorer",
        "entry": "./dist/plugin.js",
        "order": 30,
        "title": "Data explorer",
        "icon": "🔍",
        "config": {
            "entries": [
                {
                    "key": "forceReadOnly",
                    "label": "Read-only for all",
                    "description": "Every source may only read, whatever its own setting",
                    "type": "boolean",
                    "default": false,
                    "requiresRestart": true
                },
                {
                    "key": "maxRows",
                    "label": "Rows at most",
                    "description": "The most rows any source returns; 0: each source its own",
                    "type": "number",
                    "default": 0,
                    "validation": {
                        "min": 0,
                        "max": 1000000
                    },
                    "requiresRestart": true
                },
                {
                    "key": "rateLimitQueries",
                    "label": "Queries per window",
                    "description": "Per caller and source, for sources without their own limit; 0: none",
                    "type": "number",
                    "default": 0,
                    "validation": {
                        "min": 0
                    },
                    "requiresRestart": true
                },
                {
                    "key": "rateLimitWindowSeconds",
                    "label": "Window (seconds)",
                    "type": "number",
                    "default": 60,
                    "validation": {
                        "min": 1,
                        "max": 86400
                    },
                    "requiresRestart": true
                }
            ]
        }
    }
}
