{
    "name": "@qodalis/cli-server-plugin-users-postgres",
    "version": "1.0.0-beta.34",
    "description": "PostgreSQL stores for the Qodalis CLI server users plugin: users, groups, passwords, sessions, API tokens and the audit log survive restarts; the schema is versioned with the migrations plugin",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc"
    },
    "keywords": [
        "cli",
        "qodalis",
        "users",
        "postgres",
        "postgresql",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/users-postgres"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "^1.0.0-beta.29",
        "@qodalis/cli-server-plugin-databases": "^1.0.0-beta.29",
        "@qodalis/cli-server-plugin-users": "^1.0.0-beta.29",
        "pg": "^8.13.0"
    },
    "devDependencies": {
        "@types/pg": "^8.0.0",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "users-postgres",
        "entry": "./dist/plugin.js",
        "order": 5,
        "title": "Users on PostgreSQL",
        "icon": "🐘",
        "config": {
            "entries": [
                {
                    "key": "connectionString",
                    "label": "Connection string",
                    "description": "postgres://user:password@host:5432/database (kept as a secret, never returned)",
                    "type": "secret",
                    "default": null,
                    "required": true,
                    "requiresRestart": true,
                    "sensitive": true
                },
                {
                    "key": "schema",
                    "label": "Schema",
                    "description": "The schema of the tables; empty: the search path",
                    "type": "string",
                    "default": "",
                    "validation": {
                        "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$"
                    },
                    "requiresRestart": true
                },
                {
                    "key": "tablePrefix",
                    "label": "Table prefix",
                    "description": "Prepended to the table names (default Qcli)",
                    "type": "string",
                    "default": "Qcli",
                    "validation": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                    },
                    "requiresRestart": true
                }
            ],
            "needsConfiguration": true
        }
    }
}
