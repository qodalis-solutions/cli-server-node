{
    "name": "@qodalis/cli-server-plugin-public-api",
    "version": "1.0.0-beta.31",
    "description": "Public API plugin for Qodalis CLI server — host-token guard with per-account quotas and usage, the host's public OpenAPI document and Swagger UI",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc"
    },
    "keywords": [
        "cli",
        "qodalis",
        "public-api",
        "openapi",
        "rate-limit",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/public-api"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "file:../../packages/abstractions",
        "swagger-ui-dist": "^5.17.0"
    },
    "peerDependencies": {
        "express": "^4.18.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "public-api",
        "entry": "./dist/plugin.js",
        "title": "Public API",
        "icon": "🌐",
        "config": {
            "entries": [
                {
                    "key": "basePath",
                    "label": "Path",
                    "description": "Where the OpenAPI document and Swagger UI are served",
                    "type": "string",
                    "default": "/qcli/api",
                    "validation": {
                        "required": true,
                        "pattern": "^(/[A-Za-z0-9._~-]+)+$"
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "title",
                    "label": "Title",
                    "type": "string",
                    "default": "API reference",
                    "validation": {
                        "required": true,
                        "max": 100
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "openApiFile",
                    "label": "OpenAPI document",
                    "description": "A JSON file (relative paths from the plugin's data directory); empty: an empty document",
                    "type": "string",
                    "default": "",
                    "validation": {
                        "max": 500
                    },
                    "requiresRestart": true
                },
                {
                    "key": "serverUrl",
                    "label": "Server URL",
                    "description": "The document's servers URL; empty: the request's",
                    "type": "string",
                    "default": "",
                    "validation": {
                        "pattern": "^(|https?://\\S+)$"
                    },
                    "requiresRestart": true
                },
                {
                    "key": "requestsPerDay",
                    "label": "Requests per day",
                    "description": "Per account; 0: unlimited",
                    "type": "number",
                    "default": 0,
                    "validation": {
                        "min": 0
                    },
                    "requiresRestart": true
                },
                {
                    "key": "requestsPerMinute",
                    "label": "Requests per minute",
                    "description": "Per account; 0: unlimited",
                    "type": "number",
                    "default": 0,
                    "validation": {
                        "min": 0
                    },
                    "requiresRestart": true
                },
                {
                    "key": "usageRetentionDays",
                    "label": "Usage kept (days)",
                    "type": "number",
                    "default": 31,
                    "validation": {
                        "min": 1,
                        "max": 3650
                    },
                    "requiresRestart": true
                }
            ]
        }
    }
}
