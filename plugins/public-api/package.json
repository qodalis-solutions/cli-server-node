{
    "name": "@qodalis/cli-server-plugin-public-api",
    "version": "1.0.0-beta.31",
    "description": "Public API plugin for Qodalis CLI server — host-token guard with per-account quotas and usage, the host's public OpenAPI document and Swagger UI",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc"
    },
    "keywords": [
        "cli",
        "qodalis",
        "public-api",
        "openapi",
        "rate-limit",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/public-api"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "file:../../packages/abstractions",
        "swagger-ui-dist": "^5.17.0"
    },
    "peerDependencies": {
        "express": "^4.18.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "public-api",
        "autoInstall": false,
        "autoInstallReason": "publishes the host's own API routes with tokens and quotas, and needs the users plugin: set up in code",
        "title": "Public API",
        "icon": "🌐"
    }
}
