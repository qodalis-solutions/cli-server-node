{
    "name": "@qodalis/cli-server-plugin-data-explorer-postgres",
    "version": "1.0.0-beta.31",
    "description": "PostgreSQL data explorer provider plugin for Qodalis CLI server",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": ["dist", "LICENSE", "README.md"],
    "scripts": { "build": "tsc" },
    "keywords": ["cli", "qodalis", "data-explorer", "postgres", "postgresql", "plugin"],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/data-explorer-postgres"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "^1.0.0-beta.2",
        "pg": "^8.13.0"
    },
    "devDependencies": {
        "@types/pg": "^8.0.0",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "data-explorer-postgres",
        "entry": "./dist/plugin.js",
        "order": 70,
        "title": "Data explorer: PostgreSQL",
        "icon": "🐘",
        "config": {
            "entries": [
                {
                    "key": "name",
                    "label": "Source name",
                    "description": "Shown in the data explorer",
                    "type": "string",
                    "default": "postgres",
                    "validation": {
                        "required": true,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "description",
                    "label": "Description",
                    "type": "string",
                    "default": "PostgreSQL database",
                    "requiresRestart": true
                },
                {
                    "key": "connectionString",
                    "label": "Connection string",
                    "description": "e.g. postgres://user:password@host:5432/database (kept as a secret, never returned)",
                    "type": "secret",
                    "default": null,
                    "required": true,
                    "requiresRestart": true,
                    "sensitive": true
                },
                {
                    "key": "readOnly",
                    "label": "Read-only",
                    "description": "Queries may only read",
                    "type": "boolean",
                    "default": true,
                    "requiresRestart": true
                },
                {
                    "key": "timeoutMs",
                    "label": "Timeout (ms)",
                    "type": "number",
                    "default": 30000,
                    "validation": {
                        "min": 1000,
                        "max": 600000
                    },
                    "requiresRestart": true
                },
                {
                    "key": "maxRows",
                    "label": "Rows at most",
                    "type": "number",
                    "default": 1000,
                    "validation": {
                        "min": 1,
                        "max": 100000
                    },
                    "requiresRestart": true
                }
            ],
            "needsConfiguration": true
        }
    }
}
