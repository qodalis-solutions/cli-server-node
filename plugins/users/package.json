{
    "name": "@qodalis/cli-server-plugin-users",
    "version": "1.0.0-beta.32",
    "description": "User management plugin for Qodalis CLI server — authentication, sessions, groups and API tokens; records its events in the audit plugin",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "dashboard",
        "dashboard-users",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "copy-dashboard": "node scripts/copy-dashboard.js",
        "prebuild": "npm run copy-dashboard",
        "build": "tsc",
        "prepublishOnly": "npm run copy-dashboard"
    },
    "keywords": [
        "cli",
        "qodalis",
        "users",
        "auth",
        "sessions",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/users"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "file:../../packages/abstractions",
        "@qodalis/cli-server-plugin-audit": "file:../audit"
    },
    "peerDependencies": {
        "express": "^4.18.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "users",
        "entry": "./dist/plugin.js",
        "order": 10,
        "title": "Users",
        "icon": "👥",
        "config": {
            "entries": [
                {
                    "key": "defaultAdminPassword",
                    "label": "root password",
                    "description": "The seeded root user's password; empty: a random one, logged once",
                    "type": "secret",
                    "default": null,
                    "requiresRestart": true,
                    "sensitive": true
                },
                {
                    "key": "protectServer",
                    "label": "Protect the server",
                    "description": "Every route and socket needs a sign-in",
                    "type": "boolean",
                    "default": true,
                    "requiresRestart": true
                },
                {
                    "key": "allowNonExpiringTokens",
                    "label": "Tokens without expiry",
                    "description": "API tokens may be created without an expiry date",
                    "type": "boolean",
                    "default": false,
                    "requiresRestart": true
                },
                {
                    "key": "linkApprovalUrl",
                    "label": "Link approval page",
                    "description": "Where users approve a terminal's link request; empty: the dashboard's",
                    "type": "string",
                    "default": "",
                    "validation": {
                        "pattern": "^(|https?://\\S+|/(?![/\\\\])\\S*)$"
                    },
                    "requiresRestart": true
                }
            ]
        }
    }
}
