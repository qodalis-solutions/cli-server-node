{
    "name": "@qodalis/cli-server-plugin-config-redis",
    "version": "1.0.0-beta.31",
    "description": "Redis config store for Qodalis CLI server config providers: a provider's writable settings in Redis, one hash per provider section, versioned writes checked atomically",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc"
    },
    "keywords": [
        "cli",
        "qodalis",
        "config",
        "redis",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/config-redis"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "file:../../packages/abstractions",
        "ioredis": "^5.4.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "config-redis",
        "autoInstall": false,
        "autoInstallReason": "a config store, not a plugin: pass it to createCliServer({ config: { store } }) in code",
        "title": "Config on Redis",
        "icon": "🟥"
    }
}
