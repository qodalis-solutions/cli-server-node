{
    "name": "@qodalis/cli-server-plugin-config-redis",
    "version": "1.0.0-beta.31",
    "description": "Redis config store for Qodalis CLI server config providers: a provider's writable settings in Redis, one hash per provider section, versioned writes checked atomically",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc"
    },
    "keywords": [
        "cli",
        "qodalis",
        "config",
        "redis",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/config-redis"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "file:../../packages/abstractions",
        "ioredis": "^5.4.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "config-redis",
        "entry": "./dist/plugin.js",
        "order": 20,
        "title": "Config on Redis",
        "icon": "🟥",
        "config": {
            "entries": [
                {
                    "key": "url",
                    "label": "Redis URL",
                    "description": "redis://[:password@]host:6379/0 (rediss:// for TLS); kept as a secret, never returned",
                    "type": "secret",
                    "default": null,
                    "required": true,
                    "requiresRestart": true,
                    "sensitive": true
                },
                {
                    "key": "keyPrefix",
                    "label": "Key prefix",
                    "description": "Prepended to every key: <prefix><provider>:<section>",
                    "type": "string",
                    "default": "qcli:config:",
                    "validation": {
                        "max": 200
                    },
                    "requiresRestart": true
                },
                {
                    "key": "ttlSeconds",
                    "label": "Expiry (seconds)",
                    "description": "A section expires this long after its last change; 0: never",
                    "type": "number",
                    "default": 0,
                    "validation": {
                        "min": 0
                    },
                    "requiresRestart": true
                }
            ],
            "needsConfiguration": true
        }
    }
}
