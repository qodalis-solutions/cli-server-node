{
    "name": "@qodalis/cli-server-plugin-docs",
    "version": "1.0.0-beta.31",
    "description": "Docs plugin for Qodalis CLI server — markdown guides from folders or code, with front matter and variables, served as JSON",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc"
    },
    "keywords": [
        "cli",
        "qodalis",
        "docs",
        "markdown",
        "guides",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/docs"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "file:../../packages/abstractions"
    },
    "peerDependencies": {
        "express": "^4.18.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "docs",
        "entry": "./dist/plugin.js",
        "title": "Docs",
        "icon": "📖",
        "config": {
            "entries": [
                {
                    "key": "folder",
                    "label": "Folder",
                    "description": "The Markdown files (relative paths from the plugin's data directory)",
                    "type": "string",
                    "default": "pages",
                    "validation": {
                        "required": true,
                        "max": 500
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "basePath",
                    "label": "Path",
                    "description": "Where the guides are served",
                    "type": "string",
                    "default": "/qcli/docs",
                    "validation": {
                        "required": true,
                        "pattern": "^(/[A-Za-z0-9._~-]+)+$"
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "title",
                    "label": "Title",
                    "type": "string",
                    "default": "Guides",
                    "validation": {
                        "required": true,
                        "max": 100
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "name",
                    "label": "Name",
                    "type": "string",
                    "default": "Documentation",
                    "validation": {
                        "required": true,
                        "max": 100
                    },
                    "required": true,
                    "requiresRestart": true
                }
            ]
        }
    }
}
