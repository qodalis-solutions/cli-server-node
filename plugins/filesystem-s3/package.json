{
    "name": "@qodalis/cli-server-plugin-filesystem-s3",
    "version": "1.0.0-beta.34",
    "description": "Amazon S3 storage provider for Qodalis CLI server filesystem plugin",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc"
    },
    "keywords": [
        "cli",
        "qodalis",
        "filesystem",
        "s3",
        "aws",
        "file-storage",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/filesystem-s3"
    },
    "dependencies": {
        "@qodalis/cli-server-plugin-filesystem": "^1.0.0-beta.2",
        "@aws-sdk/client-s3": "^3.1004.0"
    },
    "devDependencies": {
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "filesystem-s3",
        "entry": "./dist/plugin.js",
        "title": "Filesystem S3",
        "icon": "🪣",
        "config": {
            "entries": [
                {
                    "key": "bucket",
                    "label": "Bucket",
                    "type": "string",
                    "default": "",
                    "validation": {
                        "max": 63
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "region",
                    "label": "Region",
                    "type": "string",
                    "default": "us-east-1",
                    "requiresRestart": true
                },
                {
                    "key": "prefix",
                    "label": "Key prefix",
                    "description": "Prepended to every path",
                    "type": "string",
                    "default": "",
                    "requiresRestart": true
                },
                {
                    "key": "endpoint",
                    "label": "Endpoint",
                    "description": "An S3-compatible service (MinIO); empty: AWS",
                    "type": "string",
                    "default": "",
                    "requiresRestart": true
                },
                {
                    "key": "accessKeyId",
                    "label": "Access key id",
                    "description": "Empty: the AWS default credential chain",
                    "type": "secret",
                    "default": null,
                    "requiresRestart": true,
                    "sensitive": true
                },
                {
                    "key": "secretAccessKey",
                    "label": "Secret access key",
                    "type": "secret",
                    "default": null,
                    "requiresRestart": true,
                    "sensitive": true
                },
                {
                    "key": "readOnly",
                    "label": "Read-only",
                    "description": "Uploads, new folders and deletes are refused",
                    "type": "boolean",
                    "default": true,
                    "requiresRestart": true
                }
            ],
            "needsConfiguration": true
        }
    }
}
