{
    "name": "@qodalis/cli-server-plugin-aws",
    "version": "1.0.0-beta.31",
    "description": "AWS cloud resource management plugin for Qodalis CLI Server",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "test": "vitest run"
    },
    "keywords": [
        "cli",
        "qodalis",
        "aws",
        "cloud",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/aws"
    },
    "dependencies": {
        "@aws-sdk/client-cloudwatch": "^3.700.0",
        "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
        "@aws-sdk/client-dynamodb": "^3.700.0",
        "@aws-sdk/client-ec2": "^3.700.0",
        "@aws-sdk/client-ecs": "^3.700.0",
        "@aws-sdk/client-iam": "^3.700.0",
        "@aws-sdk/client-lambda": "^3.700.0",
        "@aws-sdk/client-s3": "^3.700.0",
        "@aws-sdk/client-sns": "^3.700.0",
        "@aws-sdk/client-sqs": "^3.700.0",
        "@aws-sdk/client-sts": "^3.700.0",
        "@aws-sdk/credential-providers": "^3.700.0",
        "@aws-sdk/s3-request-presigner": "^3.700.0",
        "@qodalis/cli-server-abstractions": "file:../../packages/abstractions"
    },
    "devDependencies": {
        "aws-sdk-client-mock": "^4.0.0",
        "typescript": "^5.0.0",
        "vitest": "^4.1.12"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "aws",
        "entry": "./dist/plugin.js",
        "title": "AWS",
        "icon": "☁️",
        "config": {
            "entries": [
                {
                    "key": "region",
                    "label": "Region",
                    "description": "e.g. eu-north-1; empty: the default chain",
                    "type": "string",
                    "default": "",
                    "requiresRestart": true
                },
                {
                    "key": "profile",
                    "label": "Profile",
                    "description": "A profile of the shared AWS config; empty: none",
                    "type": "string",
                    "default": "",
                    "requiresRestart": true
                },
                {
                    "key": "accessKeyId",
                    "label": "Access key id",
                    "description": "Empty: the AWS default credential chain",
                    "type": "secret",
                    "default": null,
                    "requiresRestart": true,
                    "sensitive": true
                },
                {
                    "key": "secretAccessKey",
                    "label": "Secret access key",
                    "type": "secret",
                    "default": null,
                    "requiresRestart": true,
                    "sensitive": true
                }
            ]
        }
    }
}
