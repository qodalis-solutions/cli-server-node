{
    "name": "@qodalis/cli-server-plugin-jobs",
    "version": "1.0.0-beta.35",
    "description": "Background job scheduler plugin for Qodalis CLI server — provides job scheduling, execution history, and REST API",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "dashboard",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "copy-dashboard": "node scripts/copy-dashboard.js",
        "prebuild": "npm run copy-dashboard",
        "build": "tsc",
        "prepublishOnly": "npm run copy-dashboard"
    },
    "keywords": [
        "cli",
        "qodalis",
        "jobs",
        "scheduler",
        "background-jobs",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/jobs"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "file:../../packages/abstractions",
        "cron-parser": "^5.5.0",
        "express": "^4.21.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "jobs",
        "entry": "./dist/plugin.js",
        "title": "Jobs",
        "icon": "⏱️"
    }
}
