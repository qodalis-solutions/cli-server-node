{
    "name": "@qodalis/cli-server-plugin-filesystem-sqlite",
    "version": "1.0.0-beta.33",
    "description": "SQLite-backed storage provider for Qodalis CLI server filesystem plugin",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc"
    },
    "keywords": [
        "cli",
        "qodalis",
        "filesystem",
        "sqlite",
        "file-storage",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/filesystem-sqlite"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "^1.0.0-beta.29",
        "@qodalis/cli-server-plugin-filesystem": "^1.0.0-beta.2",
        "@qodalis/cli-server-plugin-databases": "^1.0.0-beta.29",
        "better-sqlite3": "^13.0.3"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.0",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "filesystem-sqlite",
        "entry": "./dist/plugin.js",
        "title": "Filesystem SQLite",
        "icon": "🗃️",
        "config": {
            "entries": [
                {
                    "key": "dbPath",
                    "label": "Database file",
                    "description": "The SQLite file (relative paths from the plugin's data directory; :memory: for none)",
                    "type": "string",
                    "default": "files.db",
                    "validation": {
                        "required": true,
                        "max": 500
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "tablePrefix",
                    "label": "Table prefix",
                    "description": "Prepended to the table name (default Qcli)",
                    "type": "string",
                    "default": "Qcli",
                    "validation": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                    },
                    "requiresRestart": true
                },
                {
                    "key": "readOnly",
                    "label": "Read-only",
                    "description": "Uploads, new folders and deletes are refused",
                    "type": "boolean",
                    "default": false,
                    "requiresRestart": true
                }
            ]
        }
    }
}
