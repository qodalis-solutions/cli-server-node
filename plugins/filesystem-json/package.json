{
    "name": "@qodalis/cli-server-plugin-filesystem-json",
    "version": "1.0.0-beta.34",
    "description": "JSON file-backed storage provider for Qodalis CLI server filesystem plugin",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc"
    },
    "keywords": [
        "cli",
        "qodalis",
        "filesystem",
        "json",
        "file-storage",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/filesystem-json"
    },
    "dependencies": {
        "@qodalis/cli-server-plugin-filesystem": "^1.0.0-beta.2"
    },
    "devDependencies": {
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "filesystem-json",
        "entry": "./dist/plugin.js",
        "title": "Filesystem JSON",
        "icon": "🗂️",
        "config": {
            "entries": [
                {
                    "key": "file",
                    "label": "JSON file",
                    "description": "The file the tree is kept in (relative paths from the plugin's data directory)",
                    "type": "string",
                    "default": "files.json",
                    "validation": {
                        "required": true,
                        "max": 500
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "readOnly",
                    "label": "Read-only",
                    "description": "Uploads, new folders and deletes are refused",
                    "type": "boolean",
                    "default": true,
                    "requiresRestart": true
                }
            ]
        }
    }
}
