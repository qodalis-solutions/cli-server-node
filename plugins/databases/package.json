{
    "name": "@qodalis/cli-server-plugin-databases",
    "version": "1.0.0-beta.33",
    "description": "Databases for the Qodalis CLI server: size, load and largest tables of PostgreSQL, MySQL, SQL Server and SQLite databases, and their migrations, applied under a lock, tracked and run from the dashboard, the terminal and the API",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "dashboard",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "copy-dashboard": "node scripts/copy-dashboard.js",
        "prebuild": "npm run copy-dashboard",
        "build": "tsc",
        "prepublishOnly": "npm run copy-dashboard"
    },
    "keywords": [
        "cli",
        "qodalis",
        "databases",
        "migrations",
        "database",
        "postgres",
        "mysql",
        "sqlserver",
        "sqlite",
        "cli-server",
        "plugin"
    ],
    "author": "Nicolae Lupei",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/qodalis-solutions/cli-server-node",
        "directory": "plugins/databases"
    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "file:../../packages/abstractions"
    },
    "peerDependencies": {
        "express": "^4.18.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "typescript": "^5.6.0"
    },
    "qodalis": {
        "kind": "server",
        "plugin": "databases",
        "entry": "./dist/plugin.js",
        "order": 30,
        "title": "Databases",
        "icon": "🗄️",
        "config": {
            "entries": [
                {
                    "key": "name",
                    "label": "Name",
                    "description": "The database in the API, the terminal and the dashboard",
                    "type": "string",
                    "default": "main",
                    "validation": {
                        "required": true,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "required": true,
                    "requiresRestart": true
                },
                {
                    "key": "dialect",
                    "label": "Dialect",
                    "type": "enum",
                    "default": "postgres",
                    "validation": {
                        "options": [
                            "postgres",
                            "mysql",
                            "mssql",
                            "sqlite"
                        ]
                    },
                    "requiresRestart": true
                },
                {
                    "key": "connectionString",
                    "label": "Connection",
                    "description": "A connection string (postgres://, mysql://, mssql: Server=...), or the SQLite file (relative: the plugin data folder); kept as a secret",
                    "type": "secret",
                    "default": null,
                    "required": true,
                    "requiresRestart": true,
                    "sensitive": true
                },
                {
                    "key": "migrationsFolder",
                    "label": "Migrations folder",
                    "description": "NNNN_name.up.sql / .down.sql files (relative: the plugin data folder); empty: none",
                    "type": "string",
                    "default": "",
                    "validation": {
                        "max": 500
                    },
                    "requiresRestart": true
                },
                {
                    "key": "applyOnStartup",
                    "label": "Apply on startup",
                    "description": "Pending migrations run when the server starts",
                    "type": "boolean",
                    "default": false,
                    "requiresRestart": true
                }
            ],
            "needsConfiguration": true
        }
    }
}
