    },
    "dependencies": {
        "@qodalis/cli-server-abstractions": "file:../../packages/abstractions"
    },
    "peerDependencies": {
        "express": "^4.18.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "typescript": "^5.6.0"
    }
}
